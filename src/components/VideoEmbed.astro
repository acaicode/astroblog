---
/**
 * 面向 MDX 内容的响应式视频嵌入组件。
 * 支持 YouTube、Vimeo 以及通用 iframe 来源。用法如下：
 *
 *   <VideoEmbed src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="My video" />
 *   <VideoEmbed src="https://player.vimeo.com/video/123456789" title="Vimeo clip" />
 *
 * 也可以对 YouTube 使用简写版 `id` 参数：
 *   <VideoEmbed platform="youtube" id="dQw4w9WgXcQ" title="My video" />
 */

interface Props {
  /** 完整的 iframe src URL，优先级高于 platform+id。 */
  src?: string;
  /** 配合 `id` 使用的短写视频平台。 */
  platform?: 'youtube' | 'vimeo';
  /** 视频 ID（与 `platform` 搭配使用）。 */
  id?: string;
  /** iframe 的无障碍标题。 */
  title: string;
  /** 显示在视频下方的可选说明文字。 */
  caption?: string;
}

const { src, platform, id, title, caption } = Astro.props;

function buildSrc(): string {
  if (src) return src;
  if (platform === 'youtube' && id) {
    return `https://www.youtube-nocookie.com/embed/${id}`;
  }
  if (platform === 'vimeo' && id) {
    return `https://player.vimeo.com/video/${id}`;
  }
  throw new Error('VideoEmbed: provide either `src` or both `platform` and `id`.');
}

const iframeSrc = buildSrc();
---

<figure class="video-embed my-6">
  <div class="video-embed__frame">
    <iframe
      src={iframeSrc}
      title={title}
      style="border: 0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
      loading="lazy"></iframe>
  </div>
  {
    caption && (
      <figcaption class="text-base-content/55 mt-2 text-center text-xs italic">
        {caption}
      </figcaption>
    )
  }
</figure>
