---
/**
 * 仅在 XL 屏显示的右侧面板，对应 Chirpy 风格中的
 * "Recently Updated" 和 "Trending Tags" 模块。
 *
 * 在文章页中，这里会被文章 TOC 替换（由 PostLayout 负责）。
 */
import type { Locale } from '../config';
import { getPosts, getTagsWithCount, postPath, tagPath } from '../utils/posts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const [posts, tags] = await Promise.all([getPosts(locale), getTagsWithCount(locale)]);

const recent = posts
  .slice()
  .sort((a, b) => {
    const at = (a.data.updatedDate ?? a.data.pubDate)?.valueOf?.() ?? 0;
    const bt = (b.data.updatedDate ?? b.data.pubDate)?.valueOf?.() ?? 0;
    return bt - at;
  })
  .slice(0, 5);

const trending = tags.slice(0, 8);
---

<div class="chirpy-panel">
  {
    recent.length > 0 && (
      <section class="mb-8">
        <h2 class="text-base-content/70 mb-3 text-xs font-bold tracking-[0.1em] uppercase">
          最近更新
        </h2>
        <ul class="chirpy-aside-list">
          {recent.map((post) => (
            <li>
              <a href={postPath(post)} class="chirpy-aside-item truncate">
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    trending.length > 0 && (
      <section>
        <h2 class="text-base-content/70 mb-3 text-xs font-bold tracking-[0.1em] uppercase">
          热门标签
        </h2>
        <div class="flex flex-wrap gap-2">
          {trending.map((tag) => (
            <a href={tagPath(locale, tag.name)} class="post-tag">
              {tag.name}
            </a>
          ))}
        </div>
      </section>
    )
  }
</div>
