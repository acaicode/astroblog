---
import { TWIKOO } from '../config';

const { envId, elementId, lang, version } = TWIKOO;
---

<div id={elementId} data-env-id={envId} data-el={elementId} data-lang={lang}></div>

<script is:inline define:vars={{ el: elementId, version }}>
  const container = document.getElementById(el);
  if (!container) {
    console.warn('Twikoo container not found:', el);
  } else {
    const envId = container.dataset.envId;
    const twikooEl = container.dataset.el;
    const lang = container.dataset.lang;

    if (!window.twikooInitialized) {
      const script = document.createElement('script');
      script.src = `https://cdn.jsdelivr.net/npm/twikoo@${version}/dist/twikoo.min.js`;
      script.async = true;

      script.onload = () => {
        window.twikoo.init({
          envId,
          el: '#' + twikooEl,
          path: location.pathname,
          lang,
        });
        window.twikooInitialized = true;
      };

      document.head.appendChild(script);
    } else if (window.twikoo?.init) {
      window.twikoo.init({
        envId,
        el: '#' + twikooEl,
        path: location.pathname,
        lang,
      });
    }
  }
</script>
